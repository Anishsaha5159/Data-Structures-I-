import time

sizes = [1000, 2000, 3000]

for n in sizes:
    count = 0

    start = time.perf_counter()

    for i in range(n):
        for j in range(n):
            count += 1

    end = time.perf_counter()

    execution_time = (end - start) * 1_000_000

    print("Data Size:", n)
    print("Total Operations:", count)
    print("Execution Time:", round(execution_time, 2), "microseconds")
    print()
